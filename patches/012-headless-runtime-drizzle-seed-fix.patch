--- a/.agents/scripts/headless-runtime-lib.sh
+++ b/.agents/scripts/headless-runtime-lib.sh
@@ -1056,7 +1056,16 @@
 	mkdir -p "${isolated_dir}/opencode" 2>/dev/null || return 0
 
-	if [[ ! -f "$worker_db" ]]; then
-		sqlite3 -cmd ".timeout 5000" "$shared_db" .schema 2>/dev/null | sqlite3 "$worker_db" >/dev/null 2>&1 || return 0
-	fi
+	# [ScalePass patch 012 — fix DrizzleError "table project already exists" on
+	# retry-with-persisted-session (incident 2026-05-27, kidzcity-work#65). The
+	# .schema-only copy created tables without __drizzle_migrations rows, causing
+	# drizzle to re-apply migration 1 (CREATE TABLE project) and crash on retry.
+	# Fix: trigger opencode's own migrator via `opencode --version` against the
+	# isolated XDG_DATA_HOME (t2758 pre-warm pattern). Falls back to the legacy
+	# schema-only copy if opencode is unavailable or times out.]
+	if [[ ! -f "$worker_db" ]]; then
+		if ! XDG_DATA_HOME="$isolated_dir" timeout 30 opencode --version >/dev/null 2>&1; then
+			sqlite3 "$shared_db" .schema 2>/dev/null | sqlite3 "$worker_db" >/dev/null 2>&1 || return 0
+		fi
+	fi
 
 	local shared_db_sql session_id_sql
