--- a/.agents/scripts/pulse-capacity.sh
+++ b/.agents/scripts/pulse-capacity.sh
@@ -247,6 +247,7 @@
 #   $2 - active workers
 #   $3 - minimum worker floor
 # Stdout: "<final_max_workers> <floor_active>".
+# [ScalePass patch 003 — account slot multiplier default raised 2 → 4]
 #######################################
 pulse_apply_provider_load_capacity_cap() {
 	local raw_max_workers="$1"
@@ -274,7 +275,15 @@
 	[[ "$provider_5xx" =~ ^[0-9]+$ ]] || provider_5xx=0
 	[[ "$progress_heartbeats" =~ ^[0-9]+$ ]] || progress_heartbeats=0
 
-	local account_multiplier="${PULSE_PROVIDER_ACCOUNT_SLOT_MULTIPLIER:-2}"
+	# ScalePass patch 003: upstream default of 2 caps effective_slots at 2
+	# with a 1-account OAuth pool, throttling dispatch_max to iter≤2 even
+	# when the worker pool has spare capacity. Raised to 4 as a conservative
+	# envelope test (2× upstream) to measure Anthropic rate-limit behaviour
+	# on Claude Max OAuth. Env override PULSE_PROVIDER_ACCOUNT_SLOT_MULTIPLIER
+	# still wins when set. Watch pulse.log for the rate_limit halving rule
+	# (final_max = (final_max+1)/2 in pulse-capacity.sh) — mild oscillation
+	# is expected; severe oscillation means roll back to :-2 or :-3.
+	local account_multiplier="${PULSE_PROVIDER_ACCOUNT_SLOT_MULTIPLIER:-4}"
 	[[ "$account_multiplier" =~ ^[0-9]+$ ]] || account_multiplier=2
 	((account_multiplier < 1)) && account_multiplier=1
 	local account_cap=-1
